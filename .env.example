# --- API keys (only needed for --mode remote) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=       # optional: only for --tts_model elevenlabs (free tier available)

# --- Mode: local (default; mlx-whisper + LFM2.5 1.2B + Piper, no keys) or remote (Groq + OpenRouter + a remote TTS) ---
MODE=local

# --- Remote-mode models (each also settable with --asr_model / --llm_model / --llm_provider / --tts_voice) ---
ASR_MODEL=whisper-large-v3-turbo
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_PROVIDER=deepinfra/turbo
TTS_VOICE=                # optional voice override for the remote TTS; empty = that backend's default voice

# --- TTS backend per mode (both also settable with --tts_model) ---
LOCAL_TTS=piper           # piper | pocket-tts | kokoro | kitten-tts
REMOTE_TTS=gtts           # gtts | edge-tts | groq-orpheus | elevenlabs
